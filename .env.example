# Copy to .env (backend reads HCC_* variables).

# SQLite by default; docker-compose uses PostgreSQL:
# HCC_DATABASE_URL=postgresql+psycopg://hcc:hcc@db:5432/hcc
HCC_DATABASE_URL=sqlite:///./data/hcc.db
HCC_STORAGE_DIR=./data/storage

# Damage detector: heuristic (OpenCV, uncalibrated) | mock (fixed demo regions) | model
HCC_DETECTOR=heuristic
# HCC_MODEL_WEIGHTS=/models/at-turaif-seg.pt   # only for HCC_DETECTOR=model

HCC_LOW_CONFIDENCE_THRESHOLD=0.5
HCC_GRID_COLS=6
HCC_GRID_ROWS=4
HCC_FACE_METHOD=blur          # blur | pixelate
HCC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
