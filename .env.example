# Copy to .env (backend reads HCC_* variables).

# SQLite by default; docker-compose uses PostgreSQL:
# HCC_DATABASE_URL=postgresql+psycopg://hcc:hcc@db:5432/hcc
HCC_DATABASE_URL=sqlite:///./data/hcc.db
HCC_STORAGE_DIR=./data/storage

# Damage detector: heuristic (OpenCV, uncalibrated) | mock (fixed demo regions) | synthetic_model (trained on invented images only) | model
HCC_DETECTOR=heuristic
# HCC_MODEL_WEIGHTS=/models/at-turaif-seg.pt   # only for HCC_DETECTOR=model

HCC_LOW_CONFIDENCE_THRESHOLD=0.5
HCC_GRID_COLS=6
HCC_GRID_ROWS=4
HCC_FACE_METHOD=blur          # blur | pixelate
HCC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Click-to-segment tool: auto (SAM 2 if installed + configured, else GrabCut) | sam2 | grabcut
HCC_SEGMENTER=auto
# HCC_SAM2_CHECKPOINT=models/sam2.1_hiera_tiny.pt
# HCC_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
# HCC_SAM2_MODEL_ID=facebook/sam2.1-hiera-tiny
# HCC_SAM2_DEVICE=cuda

# Accounts (create them with: python scripts/manage_users.py create)
# HCC_SESSION_HOURS=12            # login lasts this long
# HCC_COOKIE_SECURE=true          # set when the site is served over HTTPS
# HCC_LOGIN_MAX_ATTEMPTS=5        # failed logins before the account is locked
# HCC_LOGIN_LOCK_MINUTES=15
# HCC_MIN_PASSWORD_LENGTH=10
